APP_NAME="Depurador Visual"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Compose publica el sitio solo en Ubuntu por defecto.
APP_BIND=127.0.0.1
APP_HTTP_PORT=8080
APP_HTTPS_PORT=8443
SERVER_NAME=:80

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=depurador
DB_USERNAME=depurador
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
INERTIA_SSR_ENABLED=false

PARSER_AST_URL=https://parser.rodofer.cl/traza
PARSER_AST_TIMEOUT=30
MOTOR_SEMANTICO_URL=https://motor.rodofer.cl/validar
MOTOR_SEMANTICO_TIMEOUT=10
